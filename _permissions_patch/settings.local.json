{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Agent",
      "Task",
      "TodoWrite",
      "Bash",
      "PowerShell",
      "Workflow(write-chapter)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "PowerShell(Remove-Item*)",
      "PowerShell(rm *)",
      "PowerShell(rmdir *)",
      "PowerShell(del *)",
      "PowerShell(erase *)",
      "PowerShell(rd *)",
      "PowerShell(ri *)",
      "PowerShell(git push*)",
      "PowerShell(git reset --hard*)"
    ]
  }
}
