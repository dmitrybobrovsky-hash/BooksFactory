{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python tools/*)",
      "PowerShell(python tools/*)",
      "Workflow(write-chapter)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_chapter_status.ps1"
            ],
            "statusMessage": "Проверка статуса главы"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/update_production_state.ps1"
            ]
          }
        ]
      }
    ]
  }
}
